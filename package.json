{
	"name": "postboi",
	"version": "0.54.0",
	"description": "Postboi is an email provider and TypeScript SDK. Send email with one token and no DNS setup, plus SMS, WhatsApp, push and chat from the same API. You can also use your own provider (Resend, SES, Postmark and more) if you want to.",
	"homepage": "https://postboi.app",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/postboi-mail/postboi.git"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && npm run prepack",
		"docs:cli": "bun scripts/cli-docs.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"build:cli": "bun build ./src/cli/index.ts --target=node --outfile dist/cli.js",
		"prepack": "svelte-kit sync && svelte-package -i src/library && npm run build:cli && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.test.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.test.json --watch",
		"format": "oxfmt",
		"lint": "oxfmt --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"release": "bash scripts/release.sh",
		"release:examples": "bun scripts/bump-examples.ts"
	},
	"bin": {
		"postboi": "dist/cli.js"
	},
