// The still-working deploy of the docs site. `alchemy.run.ts` is the intended replacement:
// the same Worker, custom domain, flags and observability, deployed by `alchemy deploy`
// with no wrangler and no adapter. This file goes, with `@sveltejs/adapter-cloudflare`,
// once a first `alchemy deploy --stage prod --adopt` has taken the Worker over.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "postboi",
	"compatibility_date": "2026-06-14",
	"workers_dev": true,
	"preview_urls": true,
	"observability": {
		"enabled": true,
	},
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare",
	},
	"rules": [
		{
			"type": "Text",
			"globs": ["**/*.ttf"],
			"fallthrough": true,
		},
	],
	"compatibility_flags": ["nodejs_compat"],
}
