// The docs site's Worker. `wrangler deploy` deploys it, and `alchemy.run.ts` reads its
// settings from here for `alchemy deploy`. Once a first `alchemy deploy --stage prod --adopt`
// has taken the Worker over, `main` and `assets` go, with `@sveltejs/adapter-cloudflare`.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "postboi",
	"compatibility_date": "2026-06-14",
	"workers_dev": true,
	"preview_urls": true,
	"observability": {
		"enabled": true,
	},
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare",
	},
	"compatibility_flags": ["nodejs_compat"],
}
